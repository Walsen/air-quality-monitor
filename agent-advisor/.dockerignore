# The image needs only the manifest, the lockfile and src/. Everything else would bloat the build
# context AND perturb the DockerImageAsset content hash on unrelated edits (a test change would
# rebuild the image). The Dockerfile copies pyproject.toml, uv.lock and src/ — nothing here.
.venv
.git
infra
tests
# The AgentCore deploy scaffold lives under deploy/ and contains this very cdk.out
# tree; without excluding it the build-context asset copies cdk.out into itself and
# recurses until the path is too long (ENAMETOOLONG at synth).
deploy
cdk.out
**/cdk.out
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
.mypy_cache
*.md
