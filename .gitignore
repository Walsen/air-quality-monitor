# Devbox
.devbox/

# Python / uv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/

# Generated credential trees (never commit certs/keys/API keys)
certs/
*.crt
*.key
*.pem
.env.local

# CDK
infra/cdk.out/
# CDK asset staging on the root disk. The host `/tmp` is a small tmpfs a full
# synth overflows, so the infra recipes point TMPDIR here (root disk) and clean
# up after; the dir itself may persist but must never carry committed output.
.cdk-tmp/

# OS / editor
.DS_Store

# Kiro CLI / agent session settings (not project config)
.kiro/settings/cli.json
