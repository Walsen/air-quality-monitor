#!/usr/bin/env bash

# Automatically sets up your devbox environment whenever you cd into this
# directory via our direnv integration:

eval "$(devbox generate direnv --print-envrc)"

# check out https://www.jetify.com/docs/devbox/ide_configuration/direnv/
# for more details

# Per-contributor, machine-specific config (e.g. AWS_PROFILE) lives in a
# git-ignored .env.local, loaded here if present. Keeping it OUT of this committed
# file keeps the environment portable: a contributor or CI runner without a
# .env.local just skips it rather than inheriting someone else's profile. Never put
# a secret here or in .env.local that holds real material — use the platform secret
# store for those.
dotenv_if_exists .env.local
